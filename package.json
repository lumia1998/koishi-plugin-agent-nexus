{
  "name": "koishi-plugin-agent-nexus",
  "description": "Nexus Gateway agent delegation for ChatLuna",
  "version": "0.3.2-alpha.5",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "lib",
    "dist"
  ],
  "type": "commonjs",
  "author": "lumia1998",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumia1998/koishi-plugin-agent-nexus.git"
  },
  "bugs": {
    "url": "https://github.com/lumia1998/koishi-plugin-agent-nexus/issues"
  },
  "homepage": "https://github.com/lumia1998/koishi-plugin-agent-nexus#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node -e \"require(require('path').join(process.env.INIT_CWD || process.cwd(), 'scripts/build.cjs'))\"",
    "build:client": "node -e \"require(require('path').join(process.env.INIT_CWD || process.cwd(), 'scripts/build-client.cjs'))\"",
    "typecheck": "node -e \"require(require('path').join(process.env.INIT_CWD || process.cwd(), 'scripts/typecheck.cjs'))\"",
    "test": "node -e \"require(require('path').join(process.env.INIT_CWD || process.cwd(), 'scripts/test.cjs'))\"",
    "prepack": "npm run build"
  },
  "koishi": {
    "description": {
      "zh": "通过独立 Gateway 自动发现 Agent，并为 ChatLuna 注册统一调用工具",
      "en": "Discover agents through an independent Gateway and expose unified ChatLuna tools"
    },
    "service": {
      "required": [
        "chatluna",
        "chatluna_storage"
      ],
      "optional": [
        "console"
      ]
    }
  },
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "chatluna",
    "agent",
    "a2a",
    "acp",
    "gateway"
  ],
  "peerDependencies": {
    "koishi": "^4.18.0",
    "koishi-plugin-chatluna": "*",
    "koishi-plugin-chatluna-storage-service": "^1.0.6"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@koishijs/client": "^5.29.0",
    "@koishijs/plugin-console": "^5.29.0",
    "@langchain/core": "^0.3.40",
    "@types/node": "^20.14.0",
    "element-plus": "^2.14.3",
    "esbuild": "^0.25.0",
    "koishi": "^4.17.0",
    "typescript": "^5.6.0",
    "vue": "^3.5.39",
    "zod": "^3.23.0"
  },
  "allowScripts": {
    "esbuild": true,
    "vue-demi": true,
    "@parcel/watcher": true
  },
  "overrides": {
    "langsmith": "^0.6.3",
    "esbuild": "$esbuild",
    "js-yaml": "4.3.1",
    "ip-address": "10.5.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "undici": "6.28.0",
    "vite": "6.4.3",
    "@koishijs/client": {
      "element-plus": "2.14.3"
    }
  }
}
