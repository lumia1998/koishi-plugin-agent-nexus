{
  "name": "koishi-plugin-agent-nexus",
  "description": "SSH operations plus A2A and Nexus Gateway/ACP delegation for ChatLuna",
  "version": "0.1.33",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "lib",
    "dist"
  ],
  "type": "commonjs",
  "author": "lumia1998",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumia1998/koishi-plugin-agent-nexus.git"
  },
  "bugs": {
    "url": "https://github.com/lumia1998/koishi-plugin-agent-nexus/issues"
  },
  "homepage": "https://github.com/lumia1998/koishi-plugin-agent-nexus#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/nexus-agentd"
  ],
  "scripts": {
    "build": "npm run build:plugin && npm run build:agentd",
    "build:plugin": "node -e \"require(require('path').join(process.env.INIT_CWD || process.cwd(), 'scripts/build.cjs'))\"",
    "build:agentd": "npm --prefix packages/nexus-agentd run build",
    "build:client": "node -e \"require(require('path').join(process.env.INIT_CWD || process.cwd(), 'scripts/build-client.cjs'))\"",
    "typecheck": "npm run typecheck:plugin && npm run typecheck:agentd",
    "typecheck:plugin": "node -e \"require(require('path').join(process.env.INIT_CWD || process.cwd(), 'scripts/typecheck.cjs'))\"",
    "typecheck:agentd": "npm --prefix packages/nexus-agentd run typecheck",
    "test": "npm run test:plugin && npm run test:agentd",
    "test:plugin": "node -e \"require(require('path').join(process.env.INIT_CWD || process.cwd(), 'scripts/test.cjs'))\"",
    "test:agentd": "npm --prefix packages/nexus-agentd test",
    "prepack": "npm run build"
  },
  "koishi": {
    "description": {
      "zh": "通过 SSH 管理 Agent，并以 A2A 或 Nexus Gateway + ACP 委托外部 Agent",
      "en": "SSH operations with A2A and Nexus Gateway/ACP agent delegation"
    },
    "service": {
      "required": [
        "chatluna",
        "chatluna_storage"
      ],
      "optional": [
        "console",
        "server"
      ]
    }
  },
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "chatluna",
    "ssh",
    "agent",
    "hermes",
    "openclaw",
    "claude",
    "opencode",
    "codex",
    "pi",
    "a2a",
    "acp",
    "gateway"
  ],
  "peerDependencies": {
    "koishi": "^4.18.0",
    "koishi-plugin-chatluna": "*",
    "koishi-plugin-chatluna-storage-service": "^1.0.6"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0.1",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@koishijs/client": "^5.29.0",
    "@koishijs/plugin-console": "^5.29.0",
    "@langchain/core": "^0.3.40",
    "@types/node": "^20.14.0",
    "@types/ssh2": "^1.15.0",
    "@vue/shared": "^3.5.39",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "element-plus": "^2.14.3",
    "esbuild": "^0.25.0",
    "koishi": "^4.17.0",
    "typescript": "^5.6.0",
    "vue": "^3.5.39",
    "zod": "^3.23.0"
  },
  "allowScripts": {
    "ssh2": true,
    "esbuild": true,
    "vue-demi": true,
    "@parcel/watcher": true
  },
  "overrides": {
    "langsmith": "^0.6.3",
    "esbuild": "$esbuild",
    "js-yaml": "4.3.1",
    "ip-address": "10.5.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "undici": "6.28.0",
    "vite": "6.4.3",
    "@koishijs/client": {
      "element-plus": "2.14.3"
    }
  }
}
